<Window x:Class="DynamicIsland.UI.CoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DynamicIsland.UI.Converters"
        xmlns:models="clr-namespace:DynamicIsland.Core.Models;assembly=DynamicIsland.Core"
        Title="CoreWindow" Height="300" Width="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">
    
    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter" />
        <converters:PlayPauseConverter x:Key="PlayPauseConverter" />
        
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <Style TargetType="Grid" x:Key="FadeInPeek">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ActivityState.Peek}">
                    <Setter Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" BeginTime="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Grid" x:Key="FadeInExpanded">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ActivityState.Expanded}">
                    <Setter Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" BeginTime="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0">
        <Border x:Name="CoreBorder" Background="#1E1E1E" CornerRadius="16"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="16" Height="16"
                MouseEnter="CoreBorder_MouseEnter"
                MouseLeave="CoreBorder_MouseLeave"
                MouseLeftButtonUp="CoreBorder_MouseLeftButtonUp"
                Cursor="Hand">

            <Grid>
                <!-- MEDIA PEEK UI -->
                <Grid x:Name="MediaPeekContent" Style="{StaticResource FadeInPeek}" Margin="8,4,12,4" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Image Source="{Binding CurrentMedia.ArtworkBytes, Converter={StaticResource ByteArrayToImageConverter}}" 
                           Width="24" Height="24" Stretch="UniformToFill" VerticalAlignment="Center">
                        <Image.Clip>
                            <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                        </Image.Clip>
                    </Image>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Orientation="Horizontal">
                        <TextBlock Text="{Binding CurrentMedia.Title}" Foreground="White" FontSize="11" FontWeight="SemiBold" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center"/>
                        <TextBlock Text=" - " Foreground="#BBBBBB" FontSize="10" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <TextBlock Text="{Binding CurrentMedia.Artist}" Foreground="#BBBBBB" FontSize="10" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="100" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- MEDIA EXPANDED UI -->
                <Grid x:Name="MediaExpandedContent" Style="{StaticResource FadeInExpanded}" Margin="16" Width="318" Height="128">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image Source="{Binding CurrentMedia.ArtworkBytes, Converter={StaticResource ByteArrayToImageConverter}}" 
                               Width="64" Height="64" Stretch="UniformToFill" VerticalAlignment="Center">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="8" RadiusY="8" />
                            </Image.Clip>
                        </Image>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding CurrentMedia.Title}" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentMedia.Artist}" Foreground="#BBBBBB" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Command="{Binding PreviousCommand}" IsEnabled="{Binding CurrentMedia.CanPrevious}" 
                                Width="32" Height="32" Background="Transparent" BorderThickness="0" Foreground="White" Content="⏮" FontSize="16" Margin="0,0,16,0" />
                        
                        <Button Command="{Binding TogglePlayPauseCommand}" 
                                Width="40" Height="40" Background="White" BorderThickness="0" Foreground="Black" 
                                FontSize="18" FontWeight="Bold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                        <TextBlock Text="{Binding CurrentMedia.IsPlaying, Converter={StaticResource PlayPauseConverter}}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Symbol"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Command="{Binding NextCommand}" IsEnabled="{Binding CurrentMedia.CanNext}" 
                                Width="32" Height="32" Background="Transparent" BorderThickness="0" Foreground="White" Content="⏭" FontSize="16" Margin="16,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
